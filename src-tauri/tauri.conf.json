{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CharacterSynthesizer",
  "version": "0.3.0",
  "identifier": "com.haine.charactersynthesizer",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Character Synthesizer (v0.3.0 Desktop Edition)",
        "width": 1400,
        "height": 920,
        "decorations": true,
        "shadow": true,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
