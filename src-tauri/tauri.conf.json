{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CharacterSynthesizer",
  "version": "0.4.11",
  "identifier": "com.haine.charactersynthesizer",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Character Synthesizer",
        "width": 1400,
        "height": 920,
        "decorations": true,
        "shadow": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/haine-sarashina/CharacterSynthesizer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFNzcxRUE0NDMzQjNGOUUKUldTZVB6dERwQjUzN3ZhY2hyNGVWYjlhSHdOUUFMdFlTb0dXRjZiNmlvMWFTcTgxak14N1F1eWkK"
    }
  }
}